@echo off
chcp 65001 >NUL
powershell -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText('%~f0'); iex $s.Substring($s.LastIndexOf('#PSSTART')+8)"
pause
exit /b
#PSSTART
$ErrorActionPreference = 'Stop'
$name = 'Memorii tehnice'
$app  = Join-Path $env:LOCALAPPDATA 'MemoriiTehnice'
New-Item -ItemType Directory -Force -Path $app | Out-Null
$urlFile = Join-Path $app 'url.txt'
$old = if (Test-Path $urlFile) { (Get-Content $urlFile -Raw).Trim() } else { '' }
Write-Host 'Adresa aplicatiei pe GitHub Pages (ex. https://numele-tau.github.io/memorii-tehnice/)'
if ($old) { Write-Host "Enter = pastrez $old" }
$url = Read-Host 'Adresa'
if (-not $url) { $url = $old }
if (-not $url) { Write-Host 'Nu ai introdus adresa.'; exit 1 }
Set-Content -Path $urlFile -Value $url
$ico = Join-Path $app 'memorii.ico'
[IO.File]::WriteAllBytes($ico, [Convert]::FromBase64String(''))
$prof = Join-Path $app 'profil'; New-Item -ItemType Directory -Force -Path $prof | Out-Null
$cands = @(
  "${env:ProgramFiles(x86)}\Microsoft\Edge\Application\msedge.exe",
  "$env:ProgramFiles\Microsoft\Edge\Application\msedge.exe",
  "$env:ProgramFiles\Google\Chrome\Application\chrome.exe",
  "${env:ProgramFiles(x86)}\Google\Chrome\Application\chrome.exe",
  "$env:LOCALAPPDATA\Google\Chrome\Application\chrome.exe")
$browser = $cands | Where-Object { Test-Path $_ } | Select-Object -First 1
if (-not $browser) { Write-Host 'Nu am gasit Microsoft Edge sau Google Chrome.'; exit 1 }
$appArgs = "--app=$url --user-data-dir=`"$prof`" --window-size=1500,950"
$sh = New-Object -ComObject WScript.Shell
foreach ($t in @([Environment]::GetFolderPath('Desktop'), (Join-Path $env:APPDATA 'Microsoft\Windows\Start Menu\Programs'))) {
  $lnk = $sh.CreateShortcut((Join-Path $t "$name.lnk"))
  $lnk.TargetPath = $browser; $lnk.Arguments = $appArgs; $lnk.IconLocation = "$ico,0"
  $lnk.WorkingDirectory = $app; $lnk.Description = 'Memorii tehnice si scenarii de securitate la incendiu'
  $lnk.Save()
}
Write-Host ''
Write-Host "Aplicatia '$name' a fost instalata (Desktop + meniul Start)."
Write-Host 'La prima pornire introduci datele Supabase, codul echipei si (optional) cheia API Anthropic.'
Write-Host 'Bara de activitati: cu aplicatia deschisa, clic dreapta pe pictograma ei > Fixeaza in bara de activitati.'
Start-Process -FilePath $browser -ArgumentList $appArgs
